---
import Material from '../../layouts/Material.astro';
import { publishedMaterials } from '../../data/materials';
export async function getStaticPaths() { return (await publishedMaterials()).filter(e => ['first-principles', 'survey-framework'].includes(e.id)).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
---
<Material entry={entry} />
