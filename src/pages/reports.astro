---
import Shell from '../layouts/Shell.astro';
import MaterialCards from '../components/MaterialCards.astro';
import { publishedMaterials } from '../data/materials';
const entries = (await publishedMaterials()).filter(e => e.data.kind === 'analysis');
---
<Shell title="比较与研究问题"><header class="page-intro shell-width" data-reveal><span class="eyebrow">SYNTHESIZE & VERIFY</span><h1>把阅读积累为研究判断</h1><p>比较方法的前提与证据，梳理当前覆盖范围，再将不确定的问题转成可以验证的方案。</p></header><div class="shell-width collection-body"><MaterialCards entries={entries} /></div></Shell>
