---
import Material from '../../layouts/Material.astro';
import { topics } from '../../data/navigation';
import { publishedMaterials } from '../../data/materials';
export async function getStaticPaths() { const entries = await publishedMaterials(); return topics.map(topic => ({ params: { slug: topic.slug }, props: { entry: entries.find(e => e.id === topic.slug)! } })); }
const { entry } = Astro.props;
---
<Material entry={entry} />
