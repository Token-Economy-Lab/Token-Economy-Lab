---
import Shell from '../layouts/Shell.astro';
import MaterialCards from '../components/MaterialCards.astro';
import { publishedMaterials, courses, courseChapters, courseHref, materialHref } from '../data/materials';
const entries = await publishedMaterials();
const curriculum = courses.map(course => ({...course,chapters:courseChapters(entries,course.id)})).filter(c => c.chapters.length);
const tutorials = entries.filter(e => e.data.kind === 'tutorial' && !e.data.exercise).sort((a,b) => (a.data.sequence ?? 10000) - (b.data.sequence ?? 10000));
const steps = [
 {n:'01', title:'先建立成本分析的共同语言', desc:'读懂任务、模型请求与推理服务的三个层次，区分 Token、计算、费用与有效产出。', links:[['阅读地图','/materials/guides/learning-map/'],['Token、计算与任务成本','/notes/first-principles/'],['术语与指标','/materials/guides/glossary/']]},
 {n:'02', title:'沿七个方向建立技术全景', desc:'从执行轨迹进入预算与路由，再理解缓存、加速和调度；每个专题都标注深入程度与后续阅读。', links:[['技术专题','/topics/'],['当前研究现状','/reports/']]},
 {n:'03', title:'深入缓存复用与 Agent 预算', desc:'按教程、机制练习、论文精读的顺序阅读，先解释方法，再分析实验与适用边界。', links:[['缓存主线','/topics/cache/'],['预算主线','/topics/budget/'],['论文精读','/library/']]},
 {n:'04', title:'用业务案例检验理解', desc:'把一次 RAG、故障诊断或编码任务拆成成本链路，比较可用策略并列出需要验证的数据。', links:[['业务与系统','/systems/'],['方法比较与研究问题','/reports/']]}
];
const publishedPaths = new Set(entries.map(e => `/materials/${e.id}/`));
for (const step of steps) step.links = step.links.filter(([, path]) => !path.startsWith('/materials/') || publishedPaths.has(path));
---
<Shell active="learn/" title="学习路径"><header class="page-intro shell-width" data-reveal><span class="eyebrow">TWO PATHS, SHARED EVIDENCE</span><h1>从机制理解走向研究判断</h1><p>从共同基础开始，按章学习七个专题。每章都给出先修、完成目标和下一步；研究者可以从原始证据进入，再回到机制与练习。</p></header><div class="learning-audiences shell-width"><a href="#starter-path" data-reveal><span class="mono">LEARN THE MECHANISMS</span><h2>优化方向入门</h2><p>基础课程 → 专题章节 → 无需 GPU 的练习 → 业务推演</p></a><a href="#research-path" data-reveal><span class="mono">FOLLOW THE EVIDENCE</span><h2>开展相关研究</h2><p>问题分类 → 论文机制 → 实验边界 → 可推翻的验证方案</p></a></div><section id="starter-path" class="shell-width collection-section"><div class="collection-heading"><h2>全站课程</h2><span>共同基础 + 七个专题</span></div><div class="course-grid">{curriculum.map((c,i) => <section class="course-card" data-reveal><div class="course-card-heading"><span class="mono">{String(i+1).padStart(2,'0')} / {c.chapters.length} CHAPTERS</span><h3><a href={courseHref(c.id)}>{c.title}</a></h3><p>{c.description}</p></div><ol>{c.chapters.map((e,n) => <li><span>{n+1}</span><a href={materialHref(e)}>{e.data.title}</a></li>)}</ol><a class="text-link" href={courseHref(c.id)}>查看先修、学习目标与章节顺序 →</a></section>)}</div>{!curriculum.length && <div class="path-list">{steps.map(s => <section class="path-step"><span class="step-number">{s.n}</span><div><h2>{s.title}</h2><p>{s.desc}</p><div class="path-links">{s.links.map(([label,path]) => <a href={path}>{label}</a>)}</div></div></section>)}</div>}</section><section class="shell-width collection-section"><div class="collection-heading"><h2>三个贯穿练习</h2><span>手算 · 标准库回放 · 解答与误差边界</span></div><MaterialCards entries={entries.filter(e => e.data.exercise)} /></section><section class="shell-width collection-section"><div class="collection-heading"><h2>机制教程</h2><span>按教学顺序排列</span></div><MaterialCards entries={tutorials} /></section><section id="research-path" class="shell-width collection-section"><div class="collection-heading"><h2>研究者阅读入口</h2><span>全文核验 · 对照条件 · 研究假设</span></div><div class="reading-callout"><a href="/library/">按方法阅读论文精读</a><a href="/systems/">从系统与业务约束进入</a></div><MaterialCards entries={entries.filter(e => e.data.kind === 'analysis')} /></section></Shell>
