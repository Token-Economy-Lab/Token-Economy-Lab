---
import '../styles/global.css';
import { nav, href } from '../data/navigation';
const { title = '研究地图', description = 'Token 经济优化的研究与学习知识库', active = '', wide = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Token Economy Lab</title>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="site-header">
      <div class="header-inner">
        <a href={href()} class="brand" aria-label="Token Economy Lab 首页"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>Token Economy <b>Lab</b></span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">菜单</button>
        <nav id="primary-nav" aria-label="主导航">{nav.map(item => <a class:list={{ active: active === item.path }} href={href(item.path)} aria-current={active === item.path ? 'page' : undefined}>{item.title}</a>)}</nav>
        <button class="lock-button" type="button" data-lock title="退出并清除本设备的解锁凭据"><span aria-hidden="true">◷</span> 锁定</button>
      </div>
      <div class="reading-progress" aria-hidden="true"></div>
    </header>
    <main id="main" class:list={{ 'wide-main': wide }}><slot /></main>
    <footer class="site-footer"><a class="footer-brand" href={href()}>Token Economy Lab</a><p>以任务结果理解 Token 的价值</p><span>研究与学习知识库 · 2026</span></footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#primary-nav');
      menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); navigation?.classList.toggle('is-open', open); });
      document.querySelector('[data-lock]')?.addEventListener('click', () => { sessionStorage.removeItem('tel-session'); localStorage.removeItem('tel-passphrase'); localStorage.removeItem('tel-expiration'); location.hash = 'staticrypt_logout'; location.reload(); });
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const sections = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!reduced && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); } }), { threshold: .08 });
        sections.forEach((el, i) => { el.style.setProperty('--reveal-delay', `${Math.min(i % 3 * 85, 170)}ms`); el.classList.add('reveal-ready'); observer.observe(el); });
      }
      let ticking = false;
      function updateProgress() { const max = document.documentElement.scrollHeight - innerHeight; document.documentElement.style.setProperty('--reading-progress', `${max > 0 ? Math.max(0, Math.min(100, scrollY / max * 100)) : 0}%`); ticking = false; }
      addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(updateProgress); ticking = true; } }, { passive: true });
      updateProgress();
      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
      if (tocLinks.length) { const tocObserver = new IntersectionObserver(entries => { entries.filter(e=>e.isIntersecting).forEach(e=>{ tocLinks.forEach(a=>a.classList.toggle('current', a.hash === `#${e.target.id}`)); }); }, { rootMargin: '-15% 0px -65% 0px' }); document.querySelectorAll('.prose h2').forEach(el=>tocObserver.observe(el)); }
    </script>
  </body>
</html>
