---
import { render } from 'astro:content';
import Shell from './Shell.astro';
import ChapterList from '../components/ChapterList.astro';
import { topics } from '../data/navigation';
import { labels, materialHref, type Material, publishedMaterials, courses, courseChapters, courseHref } from '../data/materials';
const { entry } = Astro.props as { entry: Material };
const { Content, headings } = await render(entry);
const all = await publishedMaterials();
const hasGuide = (id: string) => all.some(e => e.id === `guides/${id}`);
const readingOrder = ['guide', 'tutorial', 'paper', 'system', 'case', 'analysis'];
const related = all.filter(e => e.id !== entry.id && e.data.kind !== 'topic' && e.data.topics.some(t => entry.data.topics.includes(t))).sort((a, b) => readingOrder.indexOf(a.data.kind) - readingOrder.indexOf(b.data.kind));
const prerequisites = entry.data.prerequisites.map(id => all.find(e => e.id === id)!);
const course = courses.find(c => c.id === entry.data.course);
const chapters = course ? courseChapters(all,course.id) : [];
const chapterIndex = chapters.findIndex(e => e.id === entry.id);
const previous = chapters[chapterIndex-1], next = chapters[chapterIndex+1];
const options = related.filter(e => e.id !== next?.id && !prerequisites.some(p => p.id === e.id));
const recommended = options.slice(0,2), remaining = options.slice(2);
const toc = headings.filter(h => h.depth === 2);
const active = entry.data.kind === 'paper' ? 'library/' : ['system', 'case'].includes(entry.data.kind) ? 'systems/' : entry.data.kind === 'topic' ? 'topics/' : 'learn/';
---
<Shell title={entry.data.title} description={entry.data.description} active={active} wide><div class="doc-layout">
  <aside class="doc-sidebar"><a class="sidebar-root" href="/learn/">全站课程</a>{course ? <><a class="course-name" href={courseHref(course.id)}>{course.title}</a><span class="sidebar-label">当前课程 · {chapters.length} 章</span><ChapterList entries={chapters} current={entry.id} /></> : <>{hasGuide('learning-map') && <a href="/materials/guides/learning-map/">阅读地图</a>}{hasGuide('glossary') && <a href="/materials/guides/glossary/">术语与指标</a>}<span class="sidebar-label">技术专题</span>{topics.map(t => <a href={`/topics/${t.slug}/`}>{t.title}</a>)}</>}<div class="sidebar-divider"></div><a href="/library/">论文精读</a><a href="/systems/">业务与系统</a><a href="/reports/">比较与研究问题</a></aside>
  <article class="doc-article"><div class="breadcrumb"><a href="/learn/">全站课程</a><span>/</span><a href={course ? courseHref(course.id) : `/${active}`}>{course?.title ?? labels[entry.data.kind]}</a></div><div class="article-meta"><span class="eyebrow">{labels[entry.data.kind]} / {entry.data.level}</span><span class="note-status">{entry.data.status}</span></div><h1>{entry.data.title}</h1><p class="article-lead">{entry.data.description}</p><div class="article-submeta">更新于 {entry.data.updated}<span>·</span>笔记阅读约 {entry.data.minutes} 分钟{entry.data.studyMinutes && <><span>·</span>学习任务约 {entry.data.studyMinutes} 分钟</>}</div>
  {course && <section class="course-context" aria-label="学习位置"><a href={courseHref(course.id)}>所属课程：{course.title} · 第 {chapterIndex+1}/{chapters.length} 章</a>{entry.data.outcomes.length > 0 && <div><strong>学完能做</strong><ul>{entry.data.outcomes.map(o => <li>{o}</li>)}</ul></div>}{next && <a class="next-required" href={materialHref(next)}>下一章：{next.data.title} →</a>}</section>}
  {prerequisites.length > 0 && <div class="prerequisite-box"><span>前置阅读</span>{prerequisites.map(e => <a href={materialHref(e)}>{e.data.title}</a>)}</div>}
  <div class="mobile-reading-nav">{course && <details class="mobile-course"><summary>课程目录 · {course.title}</summary><ChapterList entries={chapters} current={entry.id} /></details>}{toc.length > 0 && <details class="mobile-toc"><summary>本章目录</summary><nav aria-label="本章目录">{toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></details>}</div>
  <div class="prose"><Content /></div>
  {(next || options.length > 0) && <section class="related-reading"><h2>继续学习</h2>{next && <a class="next-required" href={materialHref(next)}><span>下一篇必读</span>{next.data.title} →</a>}{recommended.map(e => <a href={materialHref(e)}><span>选读 · {labels[e.data.kind]}</span>{e.data.title}</a>)}{remaining.length > 0 && <details class="more-reading"><summary>更多关联材料（{remaining.length}）</summary>{remaining.map(e => <a href={materialHref(e)}>{e.data.title}</a>)}</details>}</section>}
  <nav class="chapter-pagination" aria-label="章节翻页">{previous ? <a rel="prev" href={materialHref(previous)}><small>← 上一章</small>{previous.data.title}</a> : <a href="/learn/"><small>课程入口</small>返回全站课程</a>}{next ? <a rel="next" href={materialHref(next)}><small>下一章 →</small>{next.data.title}</a> : <a href={course ? courseHref(course.id) : '/reports/'}><small>本组阅读完成</small>{course ? '回到课程目录' : '比较方法与研究问题'}</a>}</nav></article>
  <aside class="toc"><span class="sidebar-label">本章目录</span>{toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</aside>
</div></Shell>
